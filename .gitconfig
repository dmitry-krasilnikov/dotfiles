[user]
	email = krasilnikov.d.o@gmail.com
	name = Dmitriy Krasilnikov
[core]
	pager = batcat
	autocrlf = input
[merge]
	tool = nvim
[mergetool "nvim"]
        cmd = nvim -f -c \"Gdiff\" \"$MERGED\"
[alias]
        mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
[pull]
	rebase = false
[init]
	defaultBranch = main
